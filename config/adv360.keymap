        };

        rcurly_sq: rcurly_square {
            compatible = "zmk,behavior-mod-morph";
            label = "RCURLY_SQUARE";
            #binding-cells = <0>;
            bindings = <&kp RBRC>, <&macro_rbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };


        tp_sp_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_SPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };



        hrm_left_index: homerow_mod_left_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hrm_left_ring: homerow_mod_left_ring_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_RING_SYM";
