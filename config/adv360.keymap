#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define KEYS_L 0 1 2 3 4 5 6 \
               14 15 16 17 18 19 20 \
               28 29 30 31 32 33 34 \
               46 47 48 49 50 51 \
               60 61 62 63 64
#define KEYS_R 7 8 9 10 11 12 13 \
               21 22 23 24 25 26 27 \
               39 40 41 42 43 44 45 \
               54 55 56 57 58 59 \
               71 72 73 74 75
#define KEYS_THUMBS 35 36 37 38 52 53 65 66 67 68 69 70

/* Hyper layer is index 12; hyper keycodes are written out as LC(LS(LA(LG(k))))
   rather than a macro, so the Keymap Editor can still parse the bindings. */

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        vis_nav_toggle: vis_nav_toggle {
            compatible = "zmk,behavior-macro";
            label = "VIS_NAV_TOGGLE";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog 10>;
        };

        /* Enter key: Tap for Enter, Hold for Command/GUI */

        enter_cmd: enter_command {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_COMMAND";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        /* Left thumb backspace that becomes Shift when held */

        bs_shift: backspace_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        /* Right thumb space that becomes Shift when held */

        sp_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        sp_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        spac_nav_sunaku: space_nav_sunaku {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV_SUNAKU";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        /* Smart Toggle for Sym Layer: Tap=Sticky, DoubleTap=Toggle */
        /* Hold-Tap for Sym Layer: Hold=Momentary(1), Tap=Sticky(1) */
        /* Smart Toggle for Sym Layer: Tap=Sticky(via ht), DoubleTap=Lock(tog) */
        /* Select Word: Normal=right, Shift=left */
        /* Smart Backspace: Normal=BSPC/Shift (Hold-Tap), Shift=DelWord (Option+BSPC) */

        bs_nav: backspace_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        smart_bspc: smart_backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&bs_shift LSHFT BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_bspc2: smart_backspace_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BACKSPACE_2";
            #binding-cells = <0>;
            bindings = <&bs_nav 8 BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        select_word: select_word {
            compatible = "zmk,behavior-mod-morph";
            label = "SELECT_WORD";
            #binding-cells = <0>;
            bindings = <&Mac_Select_Word_Right>, <&Mac_Select_Word_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Select Line: Normal=right, Shift=left */

        select_line: select_line {
            compatible = "zmk,behavior-mod-morph";
            label = "SELECT_LINE";
            #binding-cells = <0>;
            bindings = <&Mac_Select_Line_Right>, <&Mac_Select_Line_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Extend Word: Normal=right, Shift=left */

        extend_word: extend_word {
            compatible = "zmk,behavior-mod-morph";
            label = "EXTEND_WORD";
            #binding-cells = <0>;
            bindings = <&Mac_Extend_Word_Right>, <&Mac_Extend_Word_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Extend Line: Normal=down, Shift=up */

        extend_line: extend_line {
            compatible = "zmk,behavior-mod-morph";
            label = "EXTEND_LINE";
            #binding-cells = <0>;
            bindings = <&Mac_Extend_Line_Down>, <&Mac_Extend_Line_Up>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Hold-Tap for Nav Layer: Hold=Momentary(4), Tap=Sticky(4) */
        /* Note: Double-tap to toggle is removed to fix build compatibility constraints */

        mt_ctrl_enter: mod_tap_ctrl_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_CTRL_ENTER";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_ctrl_esc: mod_tap_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_CTRL_ESC";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_opt_esc: mod_tap_opt_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_OPT_ESC";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_opt_tab: mod_tap_opt_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_OPT_TAB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        urob_left_index: homerow_mod_left_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <390>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <190>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        sunaku_hmr_ring: homerow_mod_left_sym_sunaku_ring {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_HMR_RING";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_hmr_middle: homerow_mod_left_sym_sunaku_mid {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_HMR_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_hmr_index: homerow_mod_left_sym_sunaku {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_HMR_INDEX";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_left_pinky: sunaku_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_LEFT_PINKY";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_left_pinky_bottom: sunaku_left_pinky_bottom {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_LEFT_PINKY_BOTTOM";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_left_ring_bottom: sunaku_left_ring_bottom {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_LEFT_RING_BOTTOM";
            #binding-cells = <2>;
            tapping-term-ms = <270>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
        };

        sunaku_right_index: sunaku_right_index {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_INDEX";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        sunaku_right_middle: sunaku_right_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        sunaku_right_ring: sunaku_right_ring {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_RING";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        sunaku_right_pinky: sunaku_right_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_PINKY";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        sunaku_right_ring_bottom: sunaku_right_ring_bottom {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_RING_BOTTOM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        sunaku_right_pinky_bottom: sunaku_right_pinky_bottom {
            compatible = "zmk,behavior-hold-tap";
            label = "SUNAKU_RIGHT_PINKY_BOTTOM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <70>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        urob_left_ring: homerow_mod_left_ring_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_RING_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <390>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <230>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_right_index: homerow_mod_right_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        urob_right_ring: homerow_mod_right_ring_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_RING_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
        };

        urob_left_ring_bottom: homerow_mod_left_ring_bottom_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_RING_BOTTOM_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_right_ring_bottom: homerow_mod_right_ring_bottom_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_RING_BOTTOM_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <70>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_left_middle: homerow_mod_left_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <370>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <230>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_right_middle: homerow_mod_right_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_left_pinky: homerow_mod_left_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_left_pinky_bottom: homerow_mod_left_pinky_bottom_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_PINKY_BOTTOM_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_right_pinky: homerow_mod_right_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        urob_right_pinky_bottom: homerow_mod_right_pinky_bottom_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT_PINKY_BOTTOM_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <70>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_L KEYS_THUMBS>;
            hold-trigger-on-release;
        };

        /* Smart Toggle for Nav Layer (Layer 4): Tap=Sticky, Hold=Momentary */
        /* Replaced Tap-Dance with Hold-Tap for instant speed (Option A) */
        /* Hold-Tap for Cursor Layer: Hold=Momentary(5), Tap=Sticky(5) */
        /* Smart Toggle for Sym Layer: Tap=Sticky, DoubleTap=Lock(tog) */

        td_backup_sym: tap_dance_backup_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BACKUP_SYM";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&sl 10>, <&tog 10>;
        };

        /* Smart Toggle for Cursor Layer: Tap=Sticky, DoubleTap=Lock(tog) */

        td_cursor: tap_dance_cursor {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_CURSOR";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&sl 3>, <&tog 3>;
        };

        fat_arrow: fat_arrow_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "FAT_ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&macro_fat_arrow>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        add_assign: add_assign_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ADD_ASSIGN_MORPH";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&macro_add_assign>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        not_equal: not_equal_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "NOT_EQUAL_MORPH";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&macro_not_equal>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        underscore_arrow: underscore_arrow_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "UNDERSCORE_ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&macro_thin_arrow>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_9: morph_9_lbracket {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_9_LBRACKET";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&macro_lbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_0: morph_0_rbracket {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_0_RBRACKET";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&macro_rbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lcurly_sq: lcurly_square {
            compatible = "zmk,behavior-mod-morph";
            label = "LCURLY_SQUARE";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&macro_lbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rcurly_sq: rcurly_square {
            compatible = "zmk,behavior-mod-morph";
            label = "RCURLY_SQUARE";
            #binding-cells = <0>;
            bindings = <&kp RBRC>, <&macro_rbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        tp_sp_nav: tp_space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_SPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        sp_nav_sunaku: sp_nav_sunaku {
            compatible = "zmk,behavior-hold-tap";
            label = "SP_NAV_SUNAKU";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <60>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        hrm_left_index: tp_homerow_mod_left_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_HOMEROW_MOD_LEFT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
