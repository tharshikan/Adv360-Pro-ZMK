#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define KEYS_L 0 1 2 3 4 5 6 \
               14 15 16 17 18 19 20 \
               28 29 30 31 32 33 34 \
               46 47 48 49 50 51 \
               66 67 68 69 70
#define KEYS_R 7 8 9 10 11 12 13 \
               21 22 23 24 25 26 27 \
               39 40 41 42 43 44 45 \
               54 55 56 57 58 59 \
               71 72 73 74 75

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        /* Enter key: Tap for Enter, Hold for Command/GUI */

        enter_cmd: enter_command {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_COMMAND";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        /* Left thumb backspace that becomes Shift when held */

        bs_shift: backspace_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        /* Right thumb space that becomes Shift when held */

        sp_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        sp_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* Smart Toggle for Sym Layer: Tap=Sticky, DoubleTap=Toggle */
        /* Hold-Tap for Sym Layer: Hold=Momentary(1), Tap=Sticky(1) */
        /* Smart Toggle for Sym Layer: Tap=Sticky(via ht), DoubleTap=Lock(tog) */
        /* Select Word: Normal=right, Shift=left */
        /* Smart Backspace: Normal=BSPC/Shift (Hold-Tap), Shift=DelWord (Option+BSPC) */

        bs_nav: backspace_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        smart_bspc: smart_backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&bs_shift LSHFT BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_bspc2: smart_backspace_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BACKSPACE_2";
            #binding-cells = <0>;
            bindings = <&bs_nav 5 BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        select_word: select_word {
            compatible = "zmk,behavior-mod-morph";
            label = "SELECT_WORD";
            #binding-cells = <0>;
            bindings = <&Mac_Select_Word_Right>, <&Mac_Select_Word_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Select Line: Normal=right, Shift=left */

        select_line: select_line {
            compatible = "zmk,behavior-mod-morph";
            label = "SELECT_LINE";
            #binding-cells = <0>;
            bindings = <&Mac_Select_Line_Right>, <&Mac_Select_Line_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Extend Word: Normal=right, Shift=left */

        extend_word: extend_word {
            compatible = "zmk,behavior-mod-morph";
            label = "EXTEND_WORD";
            #binding-cells = <0>;
            bindings = <&Mac_Extend_Word_Right>, <&Mac_Extend_Word_Left>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Extend Line: Normal=down, Shift=up */

        extend_line: extend_line {
            compatible = "zmk,behavior-mod-morph";
            label = "EXTEND_LINE";
            #binding-cells = <0>;
            bindings = <&Mac_Extend_Line_Down>, <&Mac_Extend_Line_Up>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Hold-Tap for Nav Layer: Hold=Momentary(4), Tap=Sticky(4) */
        /* Note: Double-tap to toggle is removed to fix build compatibility constraints */

        mt_ctrl_enter: mod_tap_ctrl_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_CTRL_ENTER";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_ctrl_esc: mod_tap_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_CTRL_ESC";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_opt_esc: mod_tap_opt_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_OPT_ESC";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        mt_opt_tab: mod_tap_opt_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_OPT_TAB";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        lt_launcher: layer_tap_launcher {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_LAUNCHER";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <180>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        urob_left_index: homerow_mod_left_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <210>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        urob_left_ring: homerow_mod_left_ring_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT_RING_SYM";
            #binding-cells = <2>;
            tapping-term-ms = <700>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <220>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_R>;
