        /* Smart Toggle for Nav Layer (Layer 4): Tap=Sticky, Hold=Momentary */
        /* Replaced Tap-Dance with Hold-Tap for instant speed (Option A) */
        /* Hold-Tap for Cursor Layer: Hold=Momentary(5), Tap=Sticky(5) */
        /* Smart Toggle for Sym Layer: Tap=Sticky, DoubleTap=Lock(tog) */

        td_backup_sym: tap_dance_backup_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_BACKUP_SYM";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&sl 1>, <&tog 1>;
        };

        /* Smart Toggle for Cursor Layer: Tap=Sticky, DoubleTap=Lock(tog) */

        td_cursor: tap_dance_cursor {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_CURSOR";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&sl 5>, <&tog 5>;
        };

        fat_arrow: fat_arrow_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "FAT_ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&macro_fat_arrow>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        add_assign: add_assign_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ADD_ASSIGN_MORPH";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&macro_add_assign>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        not_equal: not_equal_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "NOT_EQUAL_MORPH";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&macro_not_equal>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        underscore_arrow: underscore_arrow_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "UNDERSCORE_ARROW_MORPH";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&macro_thin_arrow>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_9: morph_9_lbracket {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_9_LBRACKET";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&macro_lbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_0: morph_0_rbracket {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_0_RBRACKET";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&macro_rbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lcurly_sq: lcurly_square {
            compatible = "zmk,behavior-mod-morph";
            label = "LCURLY_SQUARE";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&macro_lbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rcurly_sq: rcurly_square {
            compatible = "zmk,behavior-mod-morph";
            label = "RCURLY_SQUARE";
            #binding-cells = <0>;
            bindings = <&kp RBRC>, <&macro_rbracket>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&to 5                    &kp N1                  &kp N2              &kp N3                    &kp N4               &kp N5            &sl 0                                                                          &mo 3                  &kp N6  &kp N7                &kp N8                           &morph_9             &morph_0                 &kp UNDERSCORE
&kp LC(LEFT)             &kp Q                   &kp P               &kp U                     &kp Y                &kp SEMI          &none                                                                          &none                  &kp K   &kp F                 &kp L                            &kp R                &kp B                    &kp BSLH
&kp LC(RS(RIGHT_ARROW))  &hrm_left_pinky LGUI A  &hrm_left_ring 9 O  &hrm_left_middle LSHFT E  &hrm_left_index 8 I  &kp G             &none        &kp LCTRL  &kp LEFT_ALT      &kp LEFT_GUI  &td_backup_sym         &none                  &kp D   &hrm_right_index 8 H  &hrm_right_middle RIGHT_SHIFT T  &hrm_right_ring 9 N  &hrm_right_pinky RGUI S  &kp TAB
&td_backup_sym           &kp X                   &kp J               &kp COMMA                 &kp EQUAL            &kp SINGLE_QUOTE                          &kp ESCAPE        &kp TAB                                                     &kp C   &kp M                 &kp W                            &kp V                &kp DOT                  &kp RSHFT
&td_cursor               &kp K_UNDO              &kp Z               &lt_launcher 7 K_COPY     &kp K_PASTE                            &smart_bspc  &sl 4      &kp ESCAPE        &kp TAB       &lt_nav_enter 4 ENTER  &sp_shift RSHFT SPACE          &kp ESCAPE            &kp QUESTION                     &kp MINUS            &to 10                   &rcurly_sq
            >;
