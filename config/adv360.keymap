    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base_urob";
            bindings = <
&to 11          &kp N1                       &kp N2                       &kp N3                     &kp N4                &kp N5            &sl 0                                                                                                     &mo 10           &kp N6  &kp N7                 &kp N8                            &morph_9                      &morph_0                        &kp UNDERSCORE
&kp QUESTION    &kp Q                        &kp P                        &kp U                      &kp Y                 &kp SEMI          &none                                                                                                     &none            &kp K   &kp F                  &kp L                             &kp R                         &kp B                           &kp BSLH
&kp ESCAPE      &urob_left_pinky LGUI A      &urob_left_ring 6 O          &urob_left_middle LSHFT E  &urob_left_index 2 I  &kp G             &none         &kp LCTRL                  &kp LEFT_ALT        &kp LEFT_GUI     &td_backup_sym              &none            &kp D   &urob_right_index 2 H  &urob_right_middle RIGHT_SHIFT T  &urob_right_ring 3 N          &urob_right_pinky RGUI S        &kp TAB
&kp LEFT_SHIFT  &urob_left_pinky_bottom 3 X  &urob_left_ring_bottom 12 J  &kp COMMA                  &kp EQUAL             &kp SINGLE_QUOTE                                           &kp LEFT_SHIFT      &macro_caps_mac                                               &kp C   &kp M                  &kp W                             &urob_right_ring_bottom 12 V  &urob_right_pinky_bottom 6 DOT  &kp RSHFT
