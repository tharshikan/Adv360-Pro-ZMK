  // Select Word (bidirectional)
  Mac_Select_Word_Right: Mac_Select_Word_Right {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <10>;
    tap-ms = <10>;
    bindings = <&kp LA(RIGHT)>, <&kp LA(LEFT)>, <&kp LA(LS(RIGHT))>;
    display-name = "Mac Select Word Right";
  };

  Mac_Select_Word_Left: Mac_Select_Word_Left {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <10>;
    tap-ms = <10>;
    bindings = <&kp LA(LEFT)>, <&kp LA(RIGHT)>, <&kp LA(LS(LEFT))>;
    display-name = "Mac Select Word Left";
  };

